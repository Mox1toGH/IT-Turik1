DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
BACKEND_URL=http://localhost:8000

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

GOOGLE_OAUTH_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=bibaboba
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5173/calendar/google-callback

DB_ENGINE=django.db.backends.postgresql
DB_NAME=itturik
DB_USER=itturik
DB_PASSWORD=itturik
DB_HOST=db
DB_PORT=5432
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=30
DB_POOL_MAX_LIFETIME=3600
DB_POOL_MAX_IDLE=600

# Redis: leave empty for local dev without Redis (in-process fallbacks are used,
# Celery tasks then run inline). Docker sets this automatically (redis://redis:6379/0);
# for manual runs with local Redis: redis://localhost:6379/0
REDIS_URL=
# Defaults to REDIS_URL; usually left as-is
#CELERY_BROKER_URL=redis://localhost:6379/1

# Dev profiling: django-debug-toolbar (/__debug__/ + admin) and django-silk (/silk/)
PROFILING_ENABLED=True
INTERNAL_IPS=127.0.0.1
#SILKY_INTERCEPT_PERCENT=100
